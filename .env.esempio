# Copia questo file e rinominalo ".env" (solo il punto e "env", nessuna estensione).
# Poi metti i tuoi valori dopo il segno =, senza spazi e senza virgolette.

# Bot Telegram (obbligatorio per ricevere le notifiche)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# eBay (consigliato: e' la fonte piu' grande). Le stesse chiavi del radar del Bari vanno bene.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# CardTrader (facoltativo): Profilo -> Impostazioni -> API
CARDTRADER_TOKEN=
